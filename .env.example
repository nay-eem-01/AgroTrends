# Copy to ".env" (git-ignored) and fill in. Never commit real values.

# --- required ---
DB_PASSWORD=change-me
GEMINI_API_KEY=change-me
# Optional, one start only: re-embed every blog (after an embedding model change).
# AI_REINDEX_ON_STARTUP=true
# at least 32 chars; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

# --- docker-compose (server) only ---
# The API's public domain; Caddy gets its HTTPS certificate. Point the domain's A record at the server first.
# API_DOMAIN=api.example.com
# Nightly backups to R2 (deploy/backup.sh): a separate bucket, with its own "Object Read & Write" token for that
# bucket only. Uses R2_ENDPOINT. Unset = backups stay on the server only.
# BACKUP_R2_BUCKET=agrotrends-backups
# BACKUP_R2_ACCESS_KEY_ID=
# BACKUP_R2_SECRET_ACCESS_KEY=

# --- optional ---
# DB_URL=jdbc:postgresql://localhost:5432/agrotrends
# DB_USERNAME=postgres
# Production (Supabase, session pooler; see docs/DEPLOY.md section 2):
# DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project ref>
# Super-admin seeding (first startup only). If INITIAL_ADMIN_PASSWORD is unset a random one is
# generated and logged once. Either way the admin must change it on first sign-in.
# INITIAL_ADMIN_EMAIL=admin@agrotrends.local
# INITIAL_ADMIN_PASSWORD=
# FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Defaults to FRONTEND_URL.
# CORS_ORIGINS=https://agrotrends.app,https://www.agrotrends.app

# Sign in with Google: the OAuth 2.0 Web client id from Google Cloud Console (not a secret).
# Unset = Google sign-in answers 503. Add the frontend origin under "Authorized JavaScript origins".
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# AI limits: questions per user per day, and paid AI calls per IP per day (all accounts on that IP).
# AI_DAILY_QUESTION_LIMIT=20
# AI_DAILY_IP_LIMIT=200

# How notifications travel: spring (default, in-process). Another value needs its NotificationPublisher
# implementation on the classpath, or the app will not start.
# NOTIFICATIONS_TRANSPORT=spring

# Moderation: open reports from different users that hide a post until a moderator decides.
# MODERATION_AUTO_HIDE_REPORTS=3

# Password-reset and confirmation e-mail. With MAIL_HOST unset, the links are written to the log instead.
# Brevo: SMTP & API -> SMTP tab in the Brevo dashboard. MAIL_USERNAME is the SMTP login shown there (not your
# account e-mail), MAIL_PASSWORD an SMTP key. MAIL_FROM must be a sender or domain verified in Brevo.
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com

# Phone confirmation and password-reset codes by SMS. With SMS_PROVIDER unset, the codes are written to the log.
# No provider is implemented yet (roadmap 10.5).
# SMS_PROVIDER=

# Image uploads. Defaults: ./uploads, served at http://localhost:8080/uploads
# STORAGE_DIR=/var/lib/agrotrends/uploads
# UPLOADS_PUBLIC_BASE_URL=https://api.example.com/uploads
# Cloudflare R2 (set R2_BUCKET to switch from the local disk). R2 -> Manage API tokens: an "Object Read & Write"
# token for this bucket only. UPLOADS_PUBLIC_BASE_URL becomes the bucket's public URL (r2.dev or a custom domain).
# R2_BUCKET=agrotrends-images
# R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# UPLOADS_PUBLIC_BASE_URL=https://images.example.com
